# 도매꾹 오픈API 키 — https://openapi.domeggook.com 에서 발급받습니다.
# 이 파일을 복사해 이름을 .env 로 바꾼 뒤, 아래 = 뒤에 키를 붙여 넣으세요.
# .env 는 깃에 올라가지 않습니다(.gitignore).
DOMEGGOOK_API_KEY=

# 네이버 메일함 — 거래처 단가표를 메일로 받을 때만. 네이버 메일 환경설정 → POP3/IMAP 사용 ON 뒤 «앱 비밀번호»를 만들어 넣습니다.
NAVER_LOGIN_ID=
NAVER_MAIL_APP_PW=
# 앱 비밀번호가 없을 때만 로그인 비밀번호 (2단계 인증 계정은 이 값으로 IMAP 에 못 들어갑니다 — 앱 비밀번호를 쓰세요)
NAVER_LOGIN_PW=
